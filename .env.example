ANTHROPIC_API_KEY=sk-ant-...
DATABASE_URL=postgresql://postgres:dev@localhost:5433/runbooks

# Optional: GitHub source
# For private repos. Public repos are limited to ~60 request per hour so it's good to set this
GITHUB_TOKEN=ghp_...

# Optional: Notion source
NOTION_TOKEN=secret_...

# Suppress verbose output from the embedding model
TRANSFORMERS_VERBOSITY=error
HF_HUB_DISABLE_IMPLICIT_TOKEN=1
